# Copy this file to .env if you run the build locally. Never commit .env.
# These are BUILD-TIME variables used by the Vercel build.
# On Vercel you set these in Project Settings -> Environment Variables.

# Base URL of the Ace Tracker push/API backend (e.g. https://your-backend.onrender.com).
# Leave unset to use the same-origin /api path (local development or single-node host).
VITE_API_URL=https://your-backend.example.com
