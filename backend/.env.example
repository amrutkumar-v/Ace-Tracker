# Copy this file to backend/.env and fill in real values. Never commit .env.
# The backend (.env) holds secrets, so it MUST stay out of version control.
#
# This Express server provides the push/reminder API and persistent SQLite
# storage. It is deployed as its own persistent host (e.g. Render or Docker),
# SEPARATE from the Vercel-hosted static frontend.

# Port the server listens on.
PORT=3000

# production or development
NODE_ENV=production

# Send the session cookie over HTTPS only. Must be true in production.
COOKIE_SECURE=true

# Directory where the SQLite database is stored. Use a persistent volume.
DATA_DIR=/data

# ---------------------------------------------------------------------------
# Web Push VAPID keys (REQUIRED — server exits if any are missing)
# ---------------------------------------------------------------------------
# Generate a key pair once:
#   npx web-push generate-vapid-keys
# Keep the SAME key pair forever. Changing it invalidates existing subscriptions.
VAPID_PUBLIC_KEY=your_real_vapid_public_key
VAPID_PRIVATE_KEY=your_real_vapid_private_key
VAPID_SUBJECT=mailto:you@example.com

# ---------------------------------------------------------------------------
# CORS — the Vercel frontend origin(s) allowed to call this API.
# Comma-separated. Example: https://ace-tracker.vercel.app
# When unset, same-origin requests are allowed (single-node deployment).
# ---------------------------------------------------------------------------
CORS_ORIGIN=https://ace-tracker.vercel.app
